# Copy to .env and adjust as needed. All settings are optional.

# Flask
SESSION_SECRET=change-me
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# Model
MODEL_PATH=image_real_or_fake.keras
ELA_QUALITY=90
# Threshold on P(real): at/above this the image is reported as authentic (0-1).
# Lower it to flag more images as doctored; raise it to be more lenient.
CLASSIFICATION_THRESHOLD=0.45

# Upload limit in bytes (default 16 MB)
MAX_CONTENT_LENGTH=16777216
