# Django API gateway configuration (copy to .env and adjust).

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default; set an absolute path if you prefer.
# DJANGO_DB_PATH=db.sqlite3

# Browser origins allowed to call the API (the React dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The Flask inference microservice.
FORGERY_API_URL=http://127.0.0.1:5000
FORGERY_API_TIMEOUT=180

# Max upload size in bytes (16 MB).
MAX_UPLOAD_SIZE=16777216
